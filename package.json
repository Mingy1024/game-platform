{
  "name": "game-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev --port 8787",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migration": "node scripts/db-migration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:deploy": "nuxt build && wrangler deploy",
    "postinstall": "prisma generate --config prisma7.config.ts && nuxt prepare"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "arctic": "^3.7.0",
    "dotenv": "^18.0.9",
    "nuxt": "^4.6.4",
    "phaser": "^4.2.1",
    "satori": "0.32.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "eslint": "^9",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@12.2.2",
  "type": "module"
}

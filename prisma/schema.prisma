// 資料庫：Cloudflare D1（SQLite）。設計見帳號與登入設計稿第 2 節。
//
// 改了這個檔案之後：
//   1. npm run db:migration -- <名稱>   產生 migrations/ 底下的 SQL
//   2. npm run db:migrate:local         套用到本機 D1
//   3. npm run db:generate              重新產生 Prisma Client

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "sqlite"
}

/// 玩家。之後每款遊戲的紀錄表都用 player_id 對到 id（不用 google_sub）。
model Player {
  /// 隨機 ID（21 字元），對外 API、紀錄、排行榜都用它
  id            String    @id
  /// google 或 guest（排行榜的訪客，精準停車設計稿第 14.2 節）
  kind          String
  /// Google 帳號代碼（ID token 的 sub）。不存名字、信箱、大頭貼
  googleSub     String?   @unique @map("google_sub")
  /// 隨機暱稱：形容詞編號、名詞編號、四位數（存編號，每種語言顯示自己的翻譯）
  nickAdj       Int       @map("nick_adj")
  nickNoun      Int       @map("nick_noun")
  nickNum       Int       @map("nick_num")
  /// 自訂暱稱；有值就顯示它
  nickCustom    String?   @map("nick_custom")
  /// 自訂暱稱正規化後的值，用來擋重複
  nickKey       String?   @unique @map("nick_key")
  /// 最後一次自訂暱稱的時間，算 7 天冷卻
  nickChangedAt DateTime? @map("nick_changed_at")
  /// 建立時間、最後使用時間（訪客 90 天清除會用到）
  createdAt     DateTime  @map("created_at")
  lastSeenAt    DateTime  @map("last_seen_at")
  /// 最後一次送成績的時間（只在收下成績時更新，打開頁面、查名次不算）。90 天沒玩的訪客照它刪除（T16）
  lastPlayedAt  DateTime? @map("last_played_at")
  /// 訪客：建立它的那一批同步代碼。建立訪客的回應掉了、用同一個 syncId 重送時，靠它找回同一個訪客（T9）
  guestSyncId   String?   @unique @map("guest_sync_id")
  sessions      Session[]
  preciseStopBests PreciseStopBest[]
  preciseStopStats PreciseStopStats?
  preciseStopSyncBatches PreciseStopSyncBatch[]
  officeEscapeBests OfficeEscapeBest[]
  mineDescentBests MineDescentBest[]

  /// 每日排程刪掉 90 天沒玩的訪客
  @@index([kind, lastPlayedAt])
  @@map("players")
}

/// 登入狀態。cookie 存隨機 token，資料庫只存它的 SHA-256。
/// Google 登入（gs_session）和訪客代號（gs_guest）共用這張表，用玩家的 kind 區分。
model Session {
  /// token 的 SHA-256（hex）
  id        String   @id
  playerId  String   @map("player_id")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// 到期時間：400 天，剩不到 200 天時使用就延長
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")

  @@index([playerId])
  @@index([expiresAt])
  @@map("sessions")
}

/// 精準停車的最佳紀錄：一個人每個模式、每一天一筆（帳號設計稿第 11 節）。
/// 只存最佳，不存每局明細（第 14 題）。
model PreciseStopBest {
  playerId   String   @map("player_id")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// daily（今日挑戰）或 free（自由模式）
  mode       String
  /// 今日挑戰的台灣日期 YYYY-MM-DD；自由模式是空字串
  dateKey    String   @map("date_key")
  score      Int
  /// 創下這個最佳分的時間（之後排行榜同分時先創下的排前面）
  achievedAt DateTime @map("achieved_at")

  @@id([playerId, mode, dateKey])
  /// 給之後的排行榜：同一天、同一模式依分數排序
  @@index([mode, dateKey, score(sort: Desc)])
  @@map("precise_stop_bests")
}

/// 精準停車的累計資料
model PreciseStopStats {
  playerId     String   @id @map("player_id")
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// 累計完美停車次數（只在紀錄卡和我的紀錄頁顯示，不上排行榜）
  perfectStops Int      @default(0) @map("perfect_stops")
  updatedAt    DateTime @map("updated_at")

  @@map("precise_stop_stats")
}

/// 已經處理過的同步批次（syncId）。同一批重送時不重複加完美次數，
/// 中間夾著其他裝置的批次也一樣（只記最後一批的話擋不住）。
/// 前端沒送成的批次隔多久都可能重送，所以一直保留，刪帳號時一起刪。
///
/// 加完美次數由資料庫觸發器 precise_stop_sync_batches_apply 做（migrations/0002 最後）：
/// 新增這一列的同一個 SQL 動作裡就把 perfect_delta 加進 precise_stop_stats，
/// 所以「這一批已經記過」就等於「次數已經加過」，不會只做一半。
model PreciseStopSyncBatch {
  playerId     String   @map("player_id")
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  syncId       String   @map("sync_id")
  perfectDelta Int      @map("perfect_delta")
  createdAt    DateTime @map("created_at")

  @@id([playerId, syncId])
  @@map("precise_stop_sync_batches")
}

/// 下班逃離辦公室的最佳紀錄（取高分，重送不會重複；沒有累計次數，所以不需要同步批次）
model OfficeEscapeBest {
  playerId   String   @map("player_id")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// daily（每天的最佳分）或 all（歷史最佳）
  mode       String
  /// daily 的台灣日期 YYYY-MM-DD；all 是空字串
  dateKey    String   @map("date_key")
  score      Int
  /// 創下這個最佳分的時間（排行榜同分時先創下的排前面）
  achievedAt DateTime @map("achieved_at")

  @@id([playerId, mode, dateKey])
  /// 排行榜：同一天、同一種榜依分數排序
  @@index([mode, dateKey, score(sort: Desc)])
  @@map("office_escape_bests")
}

/// 礦坑大逃亡的最佳紀錄（取高值，重送不會重複；沒有累計次數，所以不需要同步批次）
model MineDescentBest {
  playerId   String   @map("player_id")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// score（最高分）或 depth（最深的公尺數）
  mode       String
  /// 那一種的數值
  score      Int
  /// 創下這個最佳值的時間（排行榜同值時先創下的排前面）
  achievedAt DateTime @map("achieved_at")

  @@id([playerId, mode])
  /// 排行榜：每一種榜依數值排序
  @@index([mode, score(sort: Desc)])
  @@map("mine_descent_bests")
}

{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm run cf:deploy)",
      "Bash(npm run db:migrate:remote)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler secret *)",
      "Bash(npx wrangler d1 * --remote*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.dev.vars)",
      "Edit(./.env)",
      "Edit(./.dev.vars)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-reminder.sh\""
          }
        ]
      }
    ]
  }
}

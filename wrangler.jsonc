{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "game-platform",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // 自我參照，名稱要和 Worker 名稱一樣（OpenNext 快取用）
      "binding": "WORKER_SELF_REFERENCE",
      "service": "game-platform"
    }
  ],
  "triggers": {
    // 每天 UTC 19:00（台灣時間凌晨 3 點）清掉過期的 session，見 worker.ts
    "crons": ["0 19 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-platform",
      // 正式的 ID 在第一次部署前用 wrangler d1 create 建立後填入；本機開發用不到
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      // 改暱稱：同一個人 1 分鐘內最多送出 5 次
      "name": "NICK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "images": {
    // next/image 圖片最佳化
    "binding": "IMAGES"
  }
}
